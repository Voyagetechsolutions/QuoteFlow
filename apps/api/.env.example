# Copy to .env and fill in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quoteflow?schema=public"
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Auth — set a long random secret in production. Falls back to an insecure dev
# value if unset (fine for local only).
JWT_SECRET=""

# Set EMAIL_ENABLED=false to turn email off entirely (send endpoints no-op).
EMAIL_ENABLED="false"

# Email delivery of quotes/invoices. With SMTP_HOST unset, the app builds the
# message but does NOT send it (logs a preview instead) — set these to enable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QuoteFlow <no-reply@quoteflow.local>"

# Vision fallback for messy / scanned rate sheets, via OpenRouter
# (OpenAI-compatible). When set, extraction escalates to this model for PDFs the
# table parser can't read. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o"

# Legacy direct-Anthropic vision path (superseded by OpenRouter).
ANTHROPIC_API_KEY=""
